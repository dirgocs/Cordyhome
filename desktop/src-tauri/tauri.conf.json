{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cordyhome",
  "version": "../package.json",
  "identifier": "com.cordyhome.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Cordyhome",
    "shortDescription": "Hub local e gratuito para os aparelhos Wi-Fi da casa",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/hub/": "hub/",
      "resources/web/": "web/",
      "resources/bin/": "bin/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
